{
  "name": "signalguard-drp",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n ml,worker,api,web \"npm:ml:dev\" \"npm:worker\" \"npm:server:dev\" \"npm:web:dev\"",
    "ml:dev": "python -m uvicorn service:app --app-dir ml --host 127.0.0.1 --port 8000",
    "worker": "python ml/worker.py",
    "ml:train": "python ml/train.py",
    "sources:check": "python ml/check_sources.py",
    "db:migrate": "node server/migrate.js",
    "user:create": "node scripts/create-user.js",
    "server:dev": "node --watch server/index.js",
    "web:dev": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "lint": "eslint . && ruff check ml",
    "typecheck": "tsc -p jsconfig.json && mypy --config-file ml/mypy.ini ml",
    "test": "npm run test:js && npm run test:ml",
    "test:js": "vitest run",
    "test:ml": "python -m pytest ml/tests -q",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "setup:env": "node scripts/setup-env.js",
    "check:secrets": "node scripts/check-secrets.js",
    "release:gate": "node scripts/release-gate.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.52.0",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.64.0",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
