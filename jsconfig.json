{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "maxNodeModuleJsDepth": 0
  },
  "include": [
    "server/**/*.js",
    "api/**/*.js",
    "scripts/**/*.js",
    "server/types.d.ts"
  ]
}
