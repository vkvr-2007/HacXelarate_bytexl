# SignalGuard configuration. Copy to .env for local use (.env is gitignored) and never commit real values.
# On Vercel, set these in Project Settings > Environment Variables instead.

# ---------- Core (required) ----------
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/signalguard
# Neon: the app (Vercel) uses the POOLED string (host contains -pooler). Migrations, pg_dump and admin work use the
# DIRECT string (no -pooler), passed only on the command line: DATABASE_URL='<direct url>' npm run db:migrate
# set for hosted Postgres such as Neon (or use ?sslmode=require in the URL)
# DATABASE_SSL=true
# give up opening a database connection after this long (Node pool and Python worker)
# DATABASE_CONNECT_TIMEOUT_MS=8000
# longest a single statement may run; 0 turns it off. Applied per transaction, so it is safe through Neon's pooler.
# DATABASE_STATEMENT_TIMEOUT_MS=30000
# 32+ random characters: openssl rand -base64 48
JWT_SECRET=
# the URL people open, used for CSRF checks. Comma-separate several. Vite dev origins are also accepted outside production.
APP_ORIGIN=http://localhost:5173
# first admin, created only when the users table is empty
ADMIN_EMAIL=
# 12+ characters; remove from the environment after first start
ADMIN_PASSWORD=

# ---------- Services ----------
PORT=4000
ML_SERVICE_URL=http://127.0.0.1:8000
# shared secret between the API and the ML service (required in production)
ML_SERVICE_SECRET=
# lets the API run queued scans on demand via the ML service
WORKER_SECRET=
# Vercel Cron / GitHub Actions bearer token for /api/internal/cron
CRON_SECRET=
TRIGGER_WORKER_ON_SCAN=false
# how often something calls the scheduler. Defaults: 1440 on Vercel (Hobby cron is daily), 0 elsewhere (the worker polls).
# Use 360 if GitHub Actions rescan.yml (every 6 hours) is enabled.
# SCHEDULER_CADENCE_MINUTES=1440
# most scans one /api/internal/cron call runs (default 3, max 20). On Hobby the cron fires once a day, so this is also
# the daily limit of scheduled scans unless rescan.yml adds calls. The time budget below can stop a call sooner.
# CRON_MAX_JOBS=3

# ---------- Alerts (optional) ----------
# Slack-compatible incoming webhook; receives new High/Critical findings
ALERT_WEBHOOK_URL=
ALERT_MIN_SEVERITY=High

# ---------- Web search (optional, pick one) ----------
# brave | serpapi (defaults to whichever key is set)
WEB_SEARCH_PROVIDER=
# https://api-dashboard.search.brave.com  ($5 free credit a month)
BRAVE_SEARCH_API_KEY=
# https://serpapi.com  (250 free searches a month)
SERPAPI_API_KEY=
WEB_SEARCH_MAX_QUERIES=4

# ---------- Social sources (optional; each needs its own approval) ----------
# Google Cloud: YouTube Data API v3. About 100 searches a day per project (see DEPLOYMENT.md), and each scan uses
# up to MAX_QUERIES_PER_SOURCE searches, so roughly 25 YouTube scans a day.
YOUTUBE_API_KEY=
# https://www.reddit.com/prefs/apps  ("script" app)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
MASTODON_INSTANCE=https://mastodon.social
MASTODON_TOKEN=
# paid, pay-per-use. Ask before enabling.
X_BEARER_TOKEN=
X_MAX_LOOKUPS=25
# Instagram Graph API, business discovery
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_MAX_LOOKUPS=15
# needs threads_keyword_search approval
THREADS_ACCESS_TOKEN=
# needs Page Public Metadata Access
FACEBOOK_ACCESS_TOKEN=
META_GRAPH_VERSION=v23.0

# ---------- Tuning ----------
STORE_COUNTRY=us
COLLECTOR_TIMEOUT=10
MAX_QUERIES_PER_SOURCE=4
DOMAIN_MAX_PERMUTATIONS=150
MAX_PAGE_CHECKS=25
PAGE_CHECKS=on
WORKER_POLL_SECONDS=5
# seconds one worker or cron call may spend starting scans (keep under the 300 s function limit)
WORKER_BUDGET_SECONDS=240
# do not start another scan unless at least this many seconds of the budget are left; unstarted scans stay queued
WORKER_MIN_REMAINING_SECONDS=90
SCAN_STALE_MINUTES=10
SCAN_MAX_ATTEMPTS=3
SESSION_HOURS=12
